# 建議設定強密碼（例如：openssl rand -base64 24）以啟用 HTTP Basic Auth 保護
# 若兩者皆留空 / 未設定，伺服器會放行所有請求（僅供本機開發使用，勿在對外環境這樣做）
AUTH_USER=
AUTH_PASS=

# 資料庫驅動：sqlite（預設）或 postgres
# 留空或設為 sqlite 時，行為與過去完全相同（資料存在 .data/taskboard.sqlite）
DB_DRIVER=sqlite

# 當 DB_DRIVER=postgres 時必填，連線字串格式：
#   postgres://<user>:<password>@<host>:<port>/<database>
# 若使用下方 docker-compose 內建的 postgres service，host 請填 "postgres"
DATABASE_URL=

# 僅供 docker-compose.yml 內建的 postgres service 使用，
# 若你接外部/現有的 Postgres，這三個變數可忽略
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard
